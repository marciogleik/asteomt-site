# Configuração de Produção - ASTEO-MT API
# Copie este arquivo para .env e preencha os valores

# Banco de dados PostgreSQL (Supabase ou outro)
DATABASE_URL="postgresql://usuario:senha@host:5432/database?schema=public"

# Segredo JWT (gere uma string aleatória segura)
JWT_SECRET="sua-chave-secreta-jwt-muito-segura-aqui"

# URL do frontend (para CORS)
FRONTEND_URL="https://asteomt.com.br"

# Porta da API
PORT=3000
